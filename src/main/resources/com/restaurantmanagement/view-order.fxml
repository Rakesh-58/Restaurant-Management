<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurantmanagement.ViewOrder">
    <stylesheets>
        <URL value="@tableview.css" />
    </stylesheets>
   <children>
      <TableView fx:id="OrderView" layoutX="68.0" layoutY="113.0" prefHeight="380.0" prefWidth="650.0">
        <columns>
            <TableColumn fx:id="ordercol" prefWidth="75.0" style="-fx-alignment: center;" text="Order No" />
          <TableColumn fx:id="tablecol" prefWidth="75.0" style="-fx-alignment: center;" text="Table no" />
          <TableColumn fx:id="namecol" prefWidth="200.0" style="-fx-alignment: center;" text="Item Name" />
            <TableColumn fx:id="quantitycol" prefWidth="75.0" style="-fx-alignment: center;" text="Quantity" />
            <TableColumn fx:id="cancelcol" prefWidth="75.0" style="-fx-alignment: center;" text="Is Canceled" />
            <TableColumn fx:id="precol" prefWidth="150.0" style="-fx-alignment: center;" text="Prepared?" />
        </columns>
      </TableView>
      <Button fx:id="rbtn" layoutX="91.0" layoutY="75.0" mnemonicParsing="false" onAction="#refreshTable" style="-fx-background-color: ffe134;" text="Refresh" />
      <Button fx:id="ldbtn" layoutX="720.0" layoutY="71.0" mnemonicParsing="false" onAction="#loadDate" style="-fx-background-color: dddddd;" text="load" />
      <Button layoutX="380.0" layoutY="535.0" mnemonicParsing="false" onAction="#goBackToMain" style="-fx-background-color: ddd;" text="Back" />
      <Label prefHeight="60.0" prefWidth="800.0" style="-fx-background-color: ffe134;" text="  BR Restaurant">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
