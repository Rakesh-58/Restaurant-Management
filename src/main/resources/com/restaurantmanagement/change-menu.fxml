<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurantmanagement.ChangeMenu">
   <children>
      <Button fx:id="addButton" layoutX="339.0" layoutY="274.0" mnemonicParsing="false" onAction="#addItem" prefHeight="52.0" prefWidth="121.0" style="-fx-background-color: FFE134;" text="Add Item">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button fx:id="removeButton" layoutX="338.0" layoutY="372.0" mnemonicParsing="false" onAction="#removeItem" prefHeight="52.0" prefWidth="122.0" style="-fx-background-color: FFE134;" text="Remove Item">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button fx:id="viewButton" layoutX="339.0" layoutY="172.0" mnemonicParsing="false" onAction="#viewMenu" prefHeight="52.0" prefWidth="121.0" style="-fx-background-color: FFE134;" text="VIew Menu">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="380.0" layoutY="532.0" mnemonicParsing="false" onAction="#goBackToMain" style="-fx-background-color: ddd;" text="Back" />
      <Label prefHeight="60.0" prefWidth="800.0" style="-fx-background-color: ffe134;" text="  BR Restaurant">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
